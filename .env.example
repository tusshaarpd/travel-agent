# OpenAI API key — required for LLM orchestration and itinerary generation
OPENAI_API_KEY=

# SerpAPI key — required for real-time Google flight search
# Get one at https://serpapi.com/
SERPAPI_API_KEY=

# Booking.com MCP endpoint and API key — required for real hotel recommendations
# The endpoint should be an MCP-compatible HTTP server
BOOKING_MCP_ENDPOINT=https://your-mcp-endpoint.example.com/mcp
BOOKING_MCP_API_KEY=
